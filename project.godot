"npc_lobby1": "res://assets/Dialogic/Timelines/npc_lobby1.dtl",
"npc_lobby10": "res://assets/Dialogic/Timelines/npc_lobby10.dtl",
"npc_lobby11": "res://assets/Dialogic/Timelines/npc_lobby11.dtl",
"npc_lobby12": "res://assets/Dialogic/Timelines/npc_lobby12.dtl",
"npc_lobby1_english": "res://assets/Dialogic/Timelines/npc_lobby1_english.dtl",
"npc_lobby2": "res://assets/Dialogic/Timelines/npc_lobby2.dtl",
"npc_lobby3": "res://assets/Dialogic/Timelines/npc_lobby3.dtl",
"npc_lobby4": "res://assets/Dialogic/Timelines/npc_lobby4.dtl",
"npc_lobby5": "res://assets/Dialogic/Timelines/npc_lobby5.dtl",
"npc_lobby6": "res://assets/Dialogic/Timelines/npc_lobby6.dtl",
"npc_lobby7": "res://assets/Dialogic/Timelines/npc_lobby7.dtl",
"npc_lobby8": "res://assets/Dialogic/Timelines/npc_lobby8.dtl",
"npc_lobby9": "res://assets/Dialogic/Timelines/npc_lobby9.dtl",
"npc_lobby_tv1": "res://assets/Dialogic/Timelines/Tvs/npc_lobby_tv1.dtl",
"npc_lobby_tv2": "res://assets/Dialogic/Timelines/Tvs/npc_lobby_tv2.dtl"
}
layout/style_directory={
"FaceShow": "res://assets/Dialogic/Styles/FaceShow.tres",
"NoFaceBG": "res://assets/Dialogic/Styles/NoFaceBG.tres"
}
layout/style_list=["res://assets/Dialogic/Styles/FaceShow.tres", "res://assets/Dialogic/Styles/NoFaceBG.tres"]
layout/default_style=""
variables={}
glossary/default_case_sensitive=true
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "Sfx",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Music",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
audio/type_sound_bus="Sfx"

[display]

window/stretch/mode="viewport"
window/quality/use_taa=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/imgui-godot/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

Tileset=""
Player=""
GameTimer=""
PlayerEnemiesCollision=""
PlayerHitBox=""
sand=""
Enemie=""
Piston=""
PlayerReplay=""
Boss=""
TimerSpawner=""
ClockRigidBody=""
Npc=""
BossBomb=""
WaterTileset=""
YExpandEditor=""
XExpandEditor=""
Killbox=""
Laser=""
CdBoss=""
RailNodes=""

