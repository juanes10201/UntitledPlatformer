; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

imgui/config="uid://dqoyjbibcphgl"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PlatformerGame"
run/main_scene="res://assets/Nodes/Levels/Preload/initial_credits.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

InitialGameLoad="*res://assets/Scripts/initial_game_load.gd"
GlobalSignal="*res://assets/global_signal/global_signal.gd"
SaveGame="*res://assets/Scripts/Global/save_game.gd"
SongPlayer="*res://assets/Nodes/Levels/Preload/SongPlayer.tscn.tscn"
Edition="*res://assets/Scripts/Global/game_editions.gd"
LevelManager="*res://assets/Nodes/Levels/Preload/LevelManager.tscn"
Global="*res://assets/Scripts/Global/global_variables.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
SteamIntegration="*uid://te1b8a1y4six"
GlobalFunctions="*uid://bpmklfila6ryh"
ImGuiRoot="*uid://dugmpnsxaagba"

[debug]

file_logging/enable_file_logging=true
gdscript/max_fps=60

[dialogic]

directories/dch_directory={
"Boss1": "res://assets/Dialogic/Characters/Boss1.dch",
"Crowd": "res://assets/Dialogic/Characters/Crowd.dch",
"Holo": "res://assets/Dialogic/Characters/Holo.dch",
"Npc1": "res://assets/Dialogic/Characters/Npc1.dch",
"Player": "res://assets/Dialogic/Characters/Player.dch"
}
directories/dtl_directory={
"intro_game_news": "res://assets/Dialogic/Timelines/intro_game_news.dtl",
"lobby_initial": "res://assets/Dialogic/Timelines/lobby_initial.dtl",
"npc_boss1_holo1": "res://assets/Dialogic/Timelines/Boss/npc_boss1_holo1.dtl",
"npc_boss1_holo2": "res://assets/Dialogic/Timelines/Boss/npc_boss1_holo2.dtl",
